<%- include('partials/header') %>

<div class="app">
  <aside class="sidebar">
    <div class="sidebar-head">
      <div class="d-flex gap-2 mb-2">
        <button id="new-note" class="btn btn-primary btn-sm flex-grow-1" type="button">
          New note
        </button>
        <button
          id="export-all"
          class="btn btn-outline-secondary btn-sm"
          type="button"
          title="Download every note as a .zip of .md files">
          Export
        </button>
        <button
          id="theme-toggle"
          class="btn btn-outline-secondary btn-sm theme-toggle"
          type="button"
          title="Toggle light / dark theme"
          aria-label="Toggle light or dark theme">
          <svg class="theme-icon icon-sun" width="16" height="16" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
          <svg class="theme-icon icon-moon" width="16" height="16" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"></path>
          </svg>
        </button>
      </div>
      <input
        id="search"
        class="form-control form-control-sm"
        type="search"
        placeholder="Search notes"
        autocomplete="off">
      <div class="list-controls">
        <select id="sort" class="form-select form-select-sm" aria-label="Sort notes by">
          <option value="relevance">Best match</option>
          <option value="updated_desc">Recently edited</option>
          <option value="updated_asc">Oldest edited</option>
          <option value="created_desc">Recently created</option>
          <option value="created_asc">Oldest created</option>
          <option value="title_asc">Title A-Z</option>
          <option value="title_desc">Title Z-A</option>
        </select>
        <button
          id="pin-first"
          class="btn btn-outline-secondary btn-sm pin-first"
          type="button"
          aria-pressed="true"
          title="Pinned notes first">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 17v5M9 3h6l-1 6 3 3v2H7v-2l3-3-1-6z"></path>
          </svg>
        </button>
      </div>
      <p id="sort-note" class="sort-note d-none"></p>
    </div>
    <ul id="note-list" class="note-list"></ul>
    <p id="empty-list" class="empty-list d-none">No notes yet.</p>
  </aside>

  <main class="editor">
    <div id="editor-pane" class="editor-pane d-none">
      <div class="editor-bar">
        <span id="status" class="status"></span>
        <div class="btn-group btn-group-sm">
          <button id="toggle-preview" class="btn btn-outline-secondary" type="button">
            Preview
          </button>
          <button id="attach-image" class="btn btn-outline-secondary" type="button"
            title="Insert an image -- or just paste or drop one into the note">
            Image
          </button>
          <button id="download-note" class="btn btn-outline-secondary" type="button">
            Download
          </button>
          <button id="pdf-note" class="btn btn-outline-secondary" type="button"
            title="Save this note as a PDF (via the browser's print dialog)">
            PDF
          </button>
          <button id="pin-note" class="btn btn-outline-secondary" type="button">Pin</button>
          <button id="delete-note" class="btn btn-outline-danger" type="button">Delete</button>
        </div>
      </div>
      <textarea
        id="note-body"
        class="note-body"
        placeholder="Start typing. The first line becomes the title. Markdown works."
        spellcheck="true"></textarea>
      <div id="note-preview" class="note-preview d-none"></div>
      <!-- The Image button's actual file dialog. Hidden because a styled
           <input type=file> is a fight, and paste / drag-and-drop are the two
           routes anyone actually uses. -->
      <input
        id="image-input"
        type="file"
        accept="image/png,image/jpeg,image/gif,image/webp,image/avif"
        multiple
        hidden>
    </div>

    <div id="editor-empty" class="editor-empty">
      <p class="text-secondary mb-2">Select a note, or start a new one.</p>
      <p class="text-secondary small mb-0">
        <kbd>Ctrl</kbd> + <kbd>N</kbd> new &middot;
        <kbd>Ctrl</kbd> + <kbd>K</kbd> search &middot;
        <kbd>Ctrl</kbd> + <kbd>E</kbd> preview &middot;
        <kbd>Ctrl</kbd> + <kbd>P</kbd> PDF &middot;
        <kbd>Ctrl</kbd> + <kbd>&uarr;</kbd>/<kbd>&darr;</kbd> sort
      </p>
      <p class="text-secondary small mb-0 mt-2">
        Paste or drop an image straight into a note.
      </p>
    </div>
  </main>
</div>

<!-- Populated from the open note just before printing; hidden on screen and the
     only thing visible on paper. See the @media print rules. -->
<article id="print-area" aria-hidden="true"></article>

<script type="module" src="/js/app.js"></script>
</body>
</html>
